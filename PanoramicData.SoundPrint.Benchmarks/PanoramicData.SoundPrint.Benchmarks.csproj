<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<NeutralResourcesLanguage>en</NeutralResourcesLanguage>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<ServerGarbageCollector>true</ServerGarbageCollector>
		<ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
		<!-- Console tooling: CA1305 culture-specific formatting and CA1303 literal strings add noise without value here. -->
		<NoWarn>$(NoWarn);CA1305;CA1303;CA1062</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PanoramicData.SoundPrint\PanoramicData.SoundPrint.csproj" />
		<ProjectReference Include="..\PanoramicData.SoundPrint.Postgres\PanoramicData.SoundPrint.Postgres.csproj" />
		<ProjectReference Include="..\PanoramicData.SoundPrint.TestAudio\PanoramicData.SoundPrint.TestAudio.csproj" />
	</ItemGroup>

</Project>
