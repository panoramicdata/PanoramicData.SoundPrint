<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<NeutralResourcesLanguage>en</NeutralResourcesLanguage>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<RootNamespace>PanoramicData.SoundPrint.Demo</RootNamespace>
		<!-- Razor markup compiles to generated code that trips style analyzers; CA2007 does not apply to UI code. -->
		<NoWarn>$(NoWarn);CA2007;CA1812</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PanoramicData.SoundPrint\PanoramicData.SoundPrint.csproj" />
		<ProjectReference Include="..\PanoramicData.SoundPrint.TestAudio\PanoramicData.SoundPrint.TestAudio.csproj" />
	</ItemGroup>

</Project>
